# macOS: port 5000 is often taken by AirPlay — use 5001 locally.
PORT=5001
NODE_ENV=development

# Vercel / reverse proxy: Express trust proxy hops (default 1). Only change if you know your proxy chain.
TRUST_PROXY_HOPS=1
# Comma-separated browser origins only (scheme + host, no path — not …/sign-in).
FRONTEND_URL=http://localhost:3000,https://metcare-frontend.vercel.app

# openssl rand -base64 48
JWT_STUDENT_SECRET=

# Protects POST /api/admin/students/invite (use a long random string; same as openssl rand -hex 32)

# Supabase → Project Settings → API
# SUPABASE_URL = "Project URL" (https://xxxx.supabase.co) — no quotes needed in .env
# SUPABASE_SERVICE_ROLE_KEY = "service_role" secret (long eyJ...), NOT the anon key
# Paste the full key on ONE line. No "Bearer " prefix. No wrapping quotes unless your tool requires them.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Public URL used in activation/reset links sent by email (no trailing slash, no path)
FRONTEND_PUBLIC_URL=https://metcare-frontend.vercel.app

# (Deprecated) kept for backwards-compat; FRONTEND_PUBLIC_URL / FRONTEND_URL take precedence.
BASE_URL=http://localhost:3000

CF_ACCOUNT_ID=
CF_STREAM_API_TOKEN=
